# dependencies / build output
node_modules/
.next/
.next-verify/
out/
# generated by next dev/build; imports .next dev types, so tracking it breaks
# a fresh-clone typecheck (Next 16 docs: do not version-control)
next-env.d.ts

# env — .env.example is the only committed env file
.env
.env.*
!.env.example

# never any incremental state (ADR-0001: staleness is unrepresentable)
*.tsbuildinfo

# test artifacts
coverage/
e2e/test-results/
e2e/playwright-report/

# python (cad/)
cad/.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# loop state — evidence per run, never committed
.loop/

# uploaded drawings and their EntityGraph artifacts (VEXTRUS_STORAGE_ROOT)
.data/

# Stray sandbox artifacts at repo root: zero-byte character-device nodes
# (stat: "character special file"), not real dotfiles — some cloud
# containers materialise these instead of the home-relative files they mask.
# Tailwind v4's content scanner walks the working tree respecting
# .gitignore and EACCES's on each in turn (`next build`, ticket 10 Build
# note), so every one observed on this container is named here explicitly
# rather than a broad dotfile glob that could hide a real future file.
/.bash_profile
/.bashrc
/.gitconfig
/.idea
/.mcp.json
/.profile
/.ripgreprc
/.vscode
/.zprofile
/.zshrc
