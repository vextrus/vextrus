# dependencies / build output
node_modules/
.next/
.next-verify/
out/
# generated by next dev/build; imports .next dev types, so tracking it breaks
# a fresh-clone typecheck (Next 16 docs: do not version-control)
next-env.d.ts

# env — .env.example is the only committed env file
.env
.env.*
!.env.example

# never any incremental state (ADR-0001: staleness is unrepresentable)
*.tsbuildinfo

# test artifacts
coverage/
e2e/test-results/
e2e/playwright-report/

# python (cad/)
cad/.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# loop state — evidence per run, never committed
.loop/

# uploaded drawings and their EntityGraph artifacts (VEXTRUS_STORAGE_ROOT)
.data/
