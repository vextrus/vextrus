{
  "name": "vextrus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3210",
    "dev:bg": "bash scripts/dev-bg.sh",
    "dev:stop": "bash scripts/dev-stop.sh",
    "build": "next build",
    "start": "next start -p 3210",
    "worker": "tsx src/server/worker-main.ts",
    "corpus": "tsx src/server/corpus-main.ts",
    "verify": "node scripts/verify.mjs",
    "checkup": "node scripts/checkup.mjs",
    "parity": "bash scripts/parity.sh",
    "land": "node scripts/land.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:drift": "node scripts/db-drift.mjs",
    "db:replay": "node scripts/db-replay.mjs",
    "test:db": "vitest run -c vitest.db.config.ts",
    "loop": "node scripts/loop/conduct.mjs",
    "promote": "node scripts/wayfinder/promote.mjs",
    "reland": "node scripts/reland.mjs"
  },
  "dependencies": {
    "@trpc/server": "^11.18.0",
    "better-auth": "^1.6.27",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
