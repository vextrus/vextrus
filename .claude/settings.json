{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    "BASH_MAX_OUTPUT_LENGTH": "50000",
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "900000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/checkup.mjs\" --hook",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>"
  },
  "includeGitInstructions": false,
  "autoMemoryEnabled": false,
  "showTurnDuration": true,
  "enableAllProjectMcpServers": true,
  "skillOverrides": {
    "docx": "off",
    "pdf": "off",
    "pptx": "off",
    "xlsx": "off",
    "skill-creator": "off",
    "morning": "off",
    "dataviz": "off",
    "claude-api": "off",
    "update-config": "off",
    "artifact-capabilities": "off",
    "artifact-diagramming": "off",
    "artifact-design": "off",
    "schedule": "off",
    "run": "off",
    "loop": "off",
    "keybindings-help": "off",
    "fewer-permission-prompts": "off",
    "init": "off"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "additionalDirectories": ["/tmp"],
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Skill",
      "Task",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "mcp__github"
    ],
    "deny": [
      "Artifact",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EndConversation",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "WaitForMcpServers",
      "NotebookEdit",
      "PowerShell",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "ShareOnboardingGuide",
      "Workflow",
      "ShowOnboardingRolePicker",
      "SuggestSkills",
      "ListAgents",
      "mcp__Claude_Code_Remote__archive_session",
      "mcp__Claude_Code_Remote__create_session",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__Claude_Code_Remote__delete_trigger",
      "mcp__Claude_Code_Remote__fire_trigger",
      "mcp__Claude_Code_Remote__get_session",
      "mcp__Claude_Code_Remote__interrupt_session",
      "mcp__Claude_Code_Remote__list_environments",
      "mcp__Claude_Code_Remote__list_repos",
      "mcp__Claude_Code_Remote__list_sessions",
      "mcp__Claude_Code_Remote__list_triggers",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__set_session_tags",
      "mcp__Claude_Code_Remote__set_session_title",
      "mcp__Claude_Code_Remote__unarchive_session",
      "mcp__Claude_Code_Remote__update_trigger",
      "mcp__github__create_and_submit_pull_request_review",
      "mcp__github__create_branch",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__merge_pull_request",
      "mcp__github__push_files",
      "mcp__github__submit_pending_pull_request_review",
      "mcp__github__update_issue",
      "mcp__github__update_pull_request"
    ]
  }
}
