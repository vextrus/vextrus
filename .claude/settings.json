{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_INCLUDE_GIT_INSTRUCTIONS": "false",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    "BASH_MAX_OUTPUT_LENGTH": "50000",
    "BASH_MAX_TIMEOUT_MS": "600000"
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>"
  },
  "autoMemoryEnabled": false,
  "showTurnDuration": true,
  "enableAllProjectMcpServers": false,
  "skillOverrides": {
    "dataviz": "off",
    "claude-api": "off",
    "update-config": "off",
    "artifact-capabilities": "off",
    "artifact-diagramming": "off",
    "artifact-design": "off",
    "schedule": "off",
    "run": "off",
    "loop": "off",
    "keybindings-help": "off",
    "fewer-permission-prompts": "off",
    "init": "off"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(tsx *)",
      "Bash(git *)",
      "Bash(uv *)",
      "Bash(python *)",
      "Bash(docker compose *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(sort *)",
      "Bash(awk *)",
      "Bash(sed -n *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(time *)",
      "Bash(netstat *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(curl *)"
    ],
    "ask": ["Bash(git push *)", "Bash(git reset *)", "Bash(rm -r *)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Artifact",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EndConversation",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "LSP",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "WaitForMcpServers",
      "NotebookEdit",
      "PowerShell",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "ShareOnboardingGuide",
      "Workflow"
    ]
  }
}
