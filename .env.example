# Copy to .env. Nothing here is secret: the database is a local cluster with dev passwords.
#
# The app connects as the RLS-constrained role; migrations connect as the owner (ADR-0004).
# `pnpm db:migrate` creates vextrus_app if it is missing (dev password below; APP_DB_PASSWORD
# overrides). Postgres runs natively on 5544 — no Docker, no compose (ADR-0002).
DATABASE_URL=postgres://vextrus_app:vextrus_app_dev_password@localhost:5544/vextrus
MIGRATE_DATABASE_URL=postgres://vextrus:vextrus@localhost:5544/vextrus
# Uploaded drawings and their EntityGraph artifacts live here (absolute path); the database stores
# references, never blobs (cad-ingestion.md, ADR-0001). `.data/` is gitignored.
VEXTRUS_STORAGE_ROOT=/home/you/vextrus/.data
