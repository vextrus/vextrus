# App connects as the RLS-constrained role; migrations as the owner role (ADR-0004).
# better-auth connects as the auth-lane role: constrained, explicit policies only.
DATABASE_URL=postgres://vextrus_app:vextrus_app_dev_password@localhost:5544/vextrus
MIGRATE_DATABASE_URL=postgres://vextrus:vextrus_dev_password@localhost:5544/vextrus
AUTH_DATABASE_URL=postgres://vextrus_auth:vextrus_auth_dev_password@localhost:5544/vextrus
BETTER_AUTH_SECRET=dev-only-secret-rotate-in-prod
BETTER_AUTH_URL=http://localhost:3210
